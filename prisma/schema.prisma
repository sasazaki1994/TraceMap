generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AnalysisRunStatus {
  queued
  processing
  completed
  failed
}

enum SourceSnapshotType {
  web
  document
  note
}

enum AlertLevel {
  info
  warning
  error
}

enum SourceVerificationStatus {
  verified
  unverified
  unreachable
  invalid
}

enum ClaimSupportKind {
  direct
  supplemental
  indirect
}

enum CounterpointRelationKind {
  contradiction
  alternative_interpretation
  different_premise
  different_definition
  temporal_mismatch
}

enum ClaimConfidenceLevel {
  high
  medium
  low
  insufficient
}

enum ClaimRecencyStatus {
  current
  stale
  unknown
}

enum PropagationStepKind {
  source
  evidence_snippet
  source_interpretation
  claim
  answer_segment
}

model AnalysisRun {
  id                String            @id @default(cuid())
  question          String
  status            AnalysisRunStatus @default(queued)
  lastErrorMessage  String?           @map("last_error_message")
  answerSnapshots   AnswerSnapshot[]
  sourceSnapshots SourceSnapshot[]
  shareLinks      ShareLink[]
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@map("analysis_runs")
}

model AnswerSnapshot {
  id              String           @id @default(cuid())
  analysisRunId   String           @map("analysis_run_id")
  title           String?
  content         String
  model           String?
  graphJson       Json?            @map("graph_json")
  sourceSnapshots SourceSnapshot[]
  claims          Claim[]
  alerts          Alert[]
  createdAt       DateTime         @default(now()) @map("created_at")
  analysisRun     AnalysisRun      @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@index([analysisRunId])
  @@map("answer_snapshots")
}

model SourceSnapshot {
  id                   String                   @id @default(cuid())
  analysisRunId        String                   @map("analysis_run_id")
  answerSnapshotId     String?                  @map("answer_snapshot_id")
  sourceCacheEntryId   String?                  @map("source_cache_entry_id")
  sourceFetchSnapshotId String?                 @map("source_fetch_snapshot_id")
  label                String
  sourceType           SourceSnapshotType       @default(web) @map("source_type")
  url                  String?
  excerpt              String?
  publishedAt          DateTime?                @map("published_at")
  verificationStatus   SourceVerificationStatus @default(unverified) @map("verification_status")
  checkedAt            DateTime?                @map("checked_at")
  httpStatus           Int?                     @map("http_status")
  finalUrl             String?                  @map("final_url")
  contentType          String?                  @map("content_type")
  createdAt            DateTime                 @default(now()) @map("created_at")
  analysisRun          AnalysisRun              @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  answerSnapshot       AnswerSnapshot?          @relation(fields: [answerSnapshotId], references: [id], onDelete: SetNull)
  sourceCacheEntry     SourceCacheEntry?        @relation(fields: [sourceCacheEntryId], references: [id], onDelete: SetNull)
  sourceFetchSnapshot  SourceFetchSnapshot?     @relation(fields: [sourceFetchSnapshotId], references: [id], onDelete: SetNull)
  claimSourceSnapshots ClaimSourceSnapshot[]
  propagationSteps     ClaimPropagationStep[]

  @@index([analysisRunId])
  @@index([answerSnapshotId])
  @@index([sourceCacheEntryId])
  @@index([sourceFetchSnapshotId])
  @@map("source_snapshots")
}

model SourceCacheEntry {
  id                String                @id @default(cuid())
  normalizedUrl     String                @unique @map("normalized_url")
  originalUrl        String?               @map("original_url")
  latestFinalUrl     String?               @map("latest_final_url")
  latestHttpStatus   Int?                  @map("latest_http_status")
  latestContentType  String?               @map("latest_content_type")
  latestContentHash  String?               @map("latest_content_hash")
  latestFetchedAt    DateTime?             @map("latest_fetched_at")
  latestErrorMessage String?               @map("latest_error_message")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  fetchSnapshots     SourceFetchSnapshot[]
  sourceSnapshots    SourceSnapshot[]

  @@map("source_cache_entries")
}

model SourceFetchSnapshot {
  id                 String            @id @default(cuid())
  sourceCacheEntryId String            @map("source_cache_entry_id")
  requestedUrl        String           @map("requested_url")
  finalUrl            String?          @map("final_url")
  httpStatus          Int?             @map("http_status")
  contentType         String?          @map("content_type")
  contentHash         String?          @map("content_hash")
  excerpt             String?
  errorMessage        String?          @map("error_message")
  fetchedAt           DateTime         @default(now()) @map("fetched_at")
  sourceCacheEntry    SourceCacheEntry @relation(fields: [sourceCacheEntryId], references: [id], onDelete: Cascade)
  sourceSnapshots     SourceSnapshot[]

  @@index([sourceCacheEntryId])
  @@index([fetchedAt])
  @@map("source_fetch_snapshots")
}

model RunCacheEntry {
  id              String    @id @default(cuid())
  cacheKey        String    @unique @map("cache_key")
  normalizedTopic String    @map("normalized_topic")
  providerId      String    @map("provider_id")
  providerModel   String?   @map("provider_model")
  promptVersion   String    @map("prompt_version")
  schemaVersion   String    @map("schema_version")
  limitsProfile   String    @map("limits_profile")
  mode            String?
  payloadJson     Json      @map("payload_json")
  sourceUrlHash   String?   @map("source_url_hash")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  expiresAt       DateTime  @map("expires_at")
  lastUsedAt      DateTime? @map("last_used_at")
  hitCount        Int       @default(0) @map("hit_count")

  @@index([normalizedTopic])
  @@index([providerId])
  @@index([expiresAt])
  @@map("run_cache_entries")
}

model ShareLink {
  id            String      @id @default(cuid())
  analysisRunId String      @map("analysis_run_id")
  token         String      @unique
  expiresAt     DateTime?   @map("expires_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  analysisRun   AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@index([analysisRunId])
  @@map("share_links")
}

model Claim {
  id                   String                @id @default(cuid())
  answerSnapshotId     String                @map("answer_snapshot_id")
  summary              String
  graphNodeId          String?               @map("graph_node_id")
  createdAt            DateTime              @default(now()) @map("created_at")
  answerSnapshot       AnswerSnapshot        @relation(fields: [answerSnapshotId], references: [id], onDelete: Cascade)
  counterpoints        Counterpoint[]
  claimSourceSnapshots ClaimSourceSnapshot[]
  confidence           ClaimConfidence?
  propagationChains    ClaimPropagationChain[]
  alerts               Alert[]

  @@index([answerSnapshotId])
  @@map("claims")
}

model ClaimSourceSnapshot {
  id                String           @id @default(cuid())
  claimId           String           @map("claim_id")
  sourceSnapshotId  String           @map("source_snapshot_id")
  supportKind       ClaimSupportKind @default(direct) @map("support_kind")
  isPrimarySource   Boolean          @default(false) @map("is_primary_source")
  supportingQuote   String?          @map("supporting_quote")
  contradictionNote String?          @map("contradiction_note")
  createdAt         DateTime         @default(now()) @map("created_at")
  claim             Claim            @relation(fields: [claimId], references: [id], onDelete: Cascade)
  sourceSnapshot    SourceSnapshot   @relation(fields: [sourceSnapshotId], references: [id], onDelete: Cascade)

  @@unique([claimId, sourceSnapshotId])
  @@index([sourceSnapshotId])
  @@map("claim_source_snapshots")
}

model ClaimConfidence {
  id                     String               @id @default(cuid())
  claimId                String               @unique @map("claim_id")
  score                  Int
  level                  ClaimConfidenceLevel
  summary                String
  hasPrimarySource       Boolean              @default(false) @map("has_primary_source")
  independentSourceCount Int                  @default(0) @map("independent_source_count")
  hasSupportingQuote     Boolean              @default(false) @map("has_supporting_quote")
  recencyStatus          ClaimRecencyStatus   @default(unknown) @map("recency_status")
  hasContradiction       Boolean              @default(false) @map("has_contradiction")
  createdAt              DateTime             @default(now()) @map("created_at")
  claim                  Claim                @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@map("claim_confidences")
}

model Counterpoint {
  id             String                   @id @default(cuid())
  claimId        String                   @map("claim_id")
  summary        String
  relationKind   CounterpointRelationKind @default(contradiction) @map("relation_kind")
  graphNodeId    String?                  @map("graph_node_id")
  createdAt      DateTime                 @default(now()) @map("created_at")
  claim          Claim                    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@map("counterpoints")
}

model ClaimPropagationChain {
  id              String                 @id @default(cuid())
  claimId         String                 @map("claim_id")
  lensHint        String?                @map("lens_hint")
  summary         String?
  createdAt       DateTime               @default(now()) @map("created_at")
  claim           Claim                  @relation(fields: [claimId], references: [id], onDelete: Cascade)
  steps           ClaimPropagationStep[]

  @@index([claimId])
  @@map("claim_propagation_chains")
}

model ClaimPropagationStep {
  id                  String               @id @default(cuid())
  claimPropagationChainId String           @map("claim_propagation_chain_id")
  ordinal             Int
  stepKind            PropagationStepKind  @map("step_kind")
  label               String
  detail              String?
  sourceSnapshotId    String?              @map("source_snapshot_id")
  graphNodeId         String?              @map("graph_node_id")
  createdAt           DateTime             @default(now()) @map("created_at")
  claimPropagationChain ClaimPropagationChain @relation(fields: [claimPropagationChainId], references: [id], onDelete: Cascade)
  sourceSnapshot      SourceSnapshot?      @relation(fields: [sourceSnapshotId], references: [id], onDelete: SetNull)

  @@index([claimPropagationChainId, ordinal])
  @@index([sourceSnapshotId])
  @@map("claim_propagation_steps")
}

model Alert {
  id               String         @id @default(cuid())
  answerSnapshotId String         @map("answer_snapshot_id")
  claimId          String?        @map("claim_id")
  level            AlertLevel
  message          String
  createdAt        DateTime       @default(now()) @map("created_at")
  answerSnapshot   AnswerSnapshot @relation(fields: [answerSnapshotId], references: [id], onDelete: Cascade)
  claim            Claim?         @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([answerSnapshotId])
  @@index([claimId])
  @@map("alerts")
}
