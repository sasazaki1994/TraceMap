# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tracemap?schema=public"

# Public Beta auth
# Required in production: use a private non-default beta access code.
TRACEMAP_BETA_ACCESS_CODE="tracemap-beta"
# Required in production: use a high-entropy random secret and never commit a real value.
TRACEMAP_SESSION_SECRET="replace-with-long-random-secret"

# Provider
# Keep mock as fallback/demo path for Public Beta operations.
TRACEMAP_ANSWER_GRAPH_PROVIDER="mock"
# TRACEMAP_ANSWER_GRAPH_PROVIDER="openai"

# OpenAI provider
TRACEMAP_OPENAI_API_KEY=""
# Optional fallback key name supported by many tools.
OPENAI_API_KEY=""
TRACEMAP_OPENAI_MODEL="gpt-4o-mini"
TRACEMAP_OPENAI_TIMEOUT_MS="60000"

# Optional source discovery
TRACEMAP_SOURCE_DISCOVERY_PROVIDER="disabled"
TRACEMAP_BRAVE_SEARCH_API_KEY=""
TRACEMAP_BRAVE_SEARCH_ENDPOINT="https://api.search.brave.com/res/v1/web/search"
TRACEMAP_SOURCE_DISCOVERY_TIMEOUT_MS="8000"
